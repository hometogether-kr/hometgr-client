EVENT_APP_ENV=local
EVENT_PUBLIC_URL=http://127.0.0.1:3211
EVENT_DATABASE_URL=postgresql://hometogether_event_1_dev_app:replace_me@127.0.0.1:55441/hometogether_event_1_dev
EVENT_DATABASE_SSL=disable
# For hosted PostgreSQL, use verify-full and configure the trusted CA.
# EVENT_DATABASE_CA=
# Hosted Supabase uses the project's postgres database and event1_app role.
# EVENT_SUPABASE_PROJECT_REF=wityrxyfhwxhbtzmdsnp
# Provisioning only. The web application never reads this variable.
EVENT_DATABASE_ADMIN_URL=postgresql://event1_local_admin:replace_me@127.0.0.1:55441/postgres
EVENT_CONSENT_VERSION=event-1-local-draft
EVENT_INTAKE_OPEN=false
# Set an ISO 8601 timestamp after the closing date has been decided.
# EVENT_CLOSES_AT=
# Local PostgreSQL launcher reuses an already installed binary directory.
# EVENT_POSTGRES_BIN=C:/path/to/PostgreSQL/bin
# Configure operator access locally with: npm run ops:configure
# EVENT_OPS_ACCESS_KEY=
# Password: 4-128 characters. Quote values containing spaces or #.
# EVENT_OPS_SESSION_SECRET=
# Keep the automatically generated session secret long; edit only EVENT_OPS_ACCESS_KEY.
